# Add additional tools for MM-PBSA functionality
@mcp.tool()
async def switch_agent_skill(skill:str) -> Dict[str, Any]:
    """
    Switch to another skill.

    Parameters
    ----------
    skill : str
        Name of the skill to switch to, [ligand, mmpbsa, analysis]

    Returns
    -------
    dict
        Dictionary with result information
    """
    global agent
    if agent is None:
        return {"success": False, "error": "agent not initialized"}
    if skill not in ["ligand", "mmpbsa, analysis"]:
        return {"success": False, "error": "skill not supported"}
    elif skill == "mmpbsa":
        agent.switch_to_mmpbsa_skill()
        return {"success": True, "message": "switched to mmpbsa skill"}
    elif skill == "ligand":
        agent.switch_to_protein_ligand_skill()
        return {"success": True, "message": "switched to ligand skill"}
    elif skill == "analysis":
        agent.switch_to_analysis_skill()
        return {"success": True, "message": "switched to analysis skill"}
    


@mcp.tool()
async def create_mmpbsa_index_file(protein_selection: str = "Protein", 
                                 ligand_selection: str = "LIG") -> Dict[str, Any]:
    """
    Create index file for MM-PBSA analysis.

    Parameters
    ----------
    protein_selection : str, optional
        Selection for protein group
    ligand_selection : str, optional
        Selection for ligand group

    Returns
    -------
    dict
        Dictionary with result information
    """
    global agent
    if agent is None:
        return {"success": False, "error": "agent not initialized"}
    # global agent
    return agent.current_skill.create_mmpbsa_index_file(protein_selection, ligand_selection)